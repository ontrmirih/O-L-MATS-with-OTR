    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #071225;
      color: white;
    }
    header {
      padding: 22px 16px;
      background: #0d1b34;
      text-align: center;
      border-bottom: 2px solid #22d3ee;
    }
    header h1 { margin: 0; color: #facc15; }
    header p { color: #cbd5e1; }
    nav {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 16px;
      padding: 15px 8px;
      background: #132440;
