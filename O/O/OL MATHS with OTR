    .hero p { line-height: 1.8; color: #e2e8f0; }
    .btn {
      display: inline-block;
      margin: 8px;
      padding: 13px 20px;
      border-radius: 9px;
      background: #facc15;
      color: #071225;
      text-decoration: none;
      font-weight: bold;
    }
    section { padding: 30px 16px; }
    section h2 {
      text-align: center;
      color: #22d3ee;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      max-width: 950px;
      margin: 22px auto;
    }
    .card {
      background: #132440;
      border: 1px solid #294563;
      border-radius: 14px;
      padding: 22px;
      text-align: center;
    }
    .card h3 { color: #facc15; }
    .card p { color: #cbd5e1; line-height: 1.6; }
    footer {
      text-align: center;
      padding: 24px 12px;
      background: #020817;
      color: #cbd5e1;
